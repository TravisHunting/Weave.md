{
  "name": "weave",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Local Markdown knowledge with typed relationships and native chunk-based FTS5 search",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node app/weave/build.mjs",
    "build:desktop": "node app/weave/build.mjs --desktop",
    "build:server": "node app/weave/build.mjs --server",
    "build:server:native": "npm run build:server && cargo build --offline --locked --manifest-path src-tauri/Cargo.toml --no-default-features --features server --bin weave-server",
    "test:server": "node scripts/verify-server.mjs",
    "test:server:container": "node scripts/verify-server-container.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Windows.ps1",
    "package:windows:quick": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Windows.ps1 -QuickChecks",
    "package:linux": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-Linux.ps1",
    "package:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Package-All.ps1",
    "start": "node app/weave/server.mjs",
    "test": "node --test app/weave/tests/*.test.mjs app/tests/chat-markdown.test.mjs",
    "test:quick": "node scripts/test-quick.mjs",
    "build:quick": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Debug.ps1 -Quick",
    "test:browser": "node app/weave/verify-browser.mjs",
    "test:dynamic": "node app/weave/verify-browser.mjs --dynamic",
    "test:desktop": "node app/weave/verify-browser.mjs --desktop",
    "test:editor": "node app/weave/verify-editor.mjs",
    "test:tables": "node app/weave/verify-tables.mjs",
    "test:mermaid": "node app/weave/verify-mermaid.mjs",
    "test:layout": "node app/weave/verify-article-layout.mjs",
    "test:git": "node app/weave/verify-git.mjs",
    "test:graph": "node app/weave/verify-graph.mjs",
    "test:workspaces": "node app/weave/verify-workspaces.mjs",
    "test:kanban": "node app/weave/verify-kanban.mjs",
    "test:mobile": "node app/weave/verify-mobile.mjs",
    "test:runtime": "node app/weave/tests/runtime-smoke.mjs",
    "test:native": "node app/weave/verify-native.mjs",
    "build:test-host": "cargo build --offline --locked --manifest-path src-tauri/Cargo.toml --features native-test-host --bin weave-test-host",
    "pretest": "npm run build:test-host",
    "pretest:desktop": "npm run build:test-host",
    "pretest:git": "npm run build:test-host",
    "pretest:workspaces": "npm run build:test-host",
    "pretest:kanban": "npm run build:test-host",
    "test:git:rust": "node scripts/test-native-git.mjs",
    "bench:scale": "node scripts/benchmark-scale.mjs",
    "bench:ui": "node scripts/benchmark-ui.mjs",
    "test:server:primary": "node scripts/verify-server.mjs --primary"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@tauri-apps/cli": "2.10.1",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "esbuild": "0.28.2",
    "mermaid": "11.17.2",
    "nspell": "2.1.5",
    "playwright": "1.62.1"
  }
}
