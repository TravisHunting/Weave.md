# Pinned Linux build toolchain. setup-build-env.sh installs exactly these
# versions and package-linux.sh refuses to build with anything else, so two
# builds of the same commit produce the same files. Keep the Rust and Node
# versions in step with the Windows build machine.
RUST_VERSION=1.98.1
NODE_VERSION=24.19.0
# SHA-256 of node-v$NODE_VERSION-linux-x64.tar.xz from nodejs.org SHASUMS256.txt.
NODE_SHA256=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
# Test-only browser automation (never bundled). Matches the Windows test runtime.
PLAYWRIGHT_VERSION=1.62.1
# Builds run on Ubuntu 22.04 (glibc 2.35, WebKitGTK 4.1). The binaries then run
# on Ubuntu 22.04+, Debian 12+ (including ChromeOS Linux) and similar distros.
BUILD_DISTRO_ID=ubuntu
BUILD_DISTRO_VERSION=22.04
# Everything the build creates outside the repository lives here.
WEAVE_LINUX_HOME="${WEAVE_LINUX_HOME:-$HOME/.local/share/weave-build}"
# Package metadata written into the .deb. The maintainer must be "Name <email>";
# replace the placeholder address before publishing if you want one shown.
PACKAGE_MAINTAINER="${PACKAGE_MAINTAINER:-Travis Hunting <weave@invalid>}"
PACKAGE_COPYRIGHT="${PACKAGE_COPYRIGHT:-Travis Hunting}"
PACKAGE_HOMEPAGE="${PACKAGE_HOMEPAGE:-https://github.com/TravisHunting/WeaveV1}"
# Local podman image for arm64 cross-builds (packaging/linux/arm64-cross.Containerfile).
ARM64_CROSS_IMAGE=localhost/weave-arm64-cross:jammy
